# Server-side Gemini API key (never expose to browser or VITE_* variables)
GEMINI_API_KEY=

# Optional HTTP server port (defaults to 3000)
PORT=3000

# Optional ChatGPT plan Story activation for local development only.
# Leave disabled unless the Human Owner separately authorizes local inference.
# Even when enabled, the route rejects non-loopback, non-same-origin requests.
PCC_CHATGPT_STORY_LOCAL_ACTIVATION=0
